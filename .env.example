# ─── Required ────────────────────────────────────────────────────────────────
# Telegram bot token from @BotFather
BOT_TOKEN=replace-with-your-telegram-bot-token

# ─── Storage ─────────────────────────────────────────────────────────────────
# SQLite database file (created automatically)
DB_PATH=data/bot.db
# News older than this many days is deleted together with its price history
RETENTION_DAYS=365

# ─── Market data ─────────────────────────────────────────────────────────────
# Exchanges to connect to (ccxt ids). Public market data only — no API keys, no trading.
EXCHANGES=binance,bybit,okx,kraken
# Exchange whose 1-minute candles are used to remember BTC/ETH prices around each news item
PRICE_HISTORY_EXCHANGE=binance

# ─── History ─────────────────────────────────────────────────────────────────
# On first start, import ~90 days of past headlines from the GDELT archive (runs in the background, ~20 min)
HISTORY_IMPORT=true

# ─── Optional premium sources (leave empty to disable) ───────────────────────
# CryptoPanic API token (news + community bullish/bearish votes): https://cryptopanic.com/developers/api/
CRYPTOPANIC_TOKEN=
# X (Twitter) API v2 bearer token — Basic tier or higher. Accounts to follow are listed in X_ACCOUNTS.
X_BEARER_TOKEN=
# X_ACCOUNTS=DeItaone,WatcherGuru,tier10k,KobeissiLetter,whale_alert,lookonchain,federalreserve,SECGov

# ─── Operations ──────────────────────────────────────────────────────────────
# Telegram user ids (comma-separated) allowed to use /admin. Find yours with @userinfobot.
ADMIN_IDS=
LOG_LEVEL=INFO
# Optional log file (rotated at 5 MB, 5 files kept), e.g. data/bot.log
LOG_FILE=
